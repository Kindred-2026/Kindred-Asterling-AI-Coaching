# Local development configuration for `pnpm dev` (root).
#
# Copy this file to `.env.dev` (git-ignored) and fill in your own values.
# Values you leave blank are OK: the launcher supplies sensible defaults for
# everything it controls. Full walkthrough: docs/local-development.md.
#
# Precedence: your shell environment > this file > built-in defaults. The
# shell always wins for an explicitly set nonblank value.
#
# The launcher forwards ONLY public `VITE_*` values to the browser (Vite)
# child. A blank or unset `VITE_*` key is treated as "not set" — it is never
# forwarded as an empty string — so Vite falls back to
# `artifacts/kindred-coach/.env.local` (the Auth0 onboarding file) for that
# key. Server secrets (MONGODB_*, RESEND_API_KEY, OPENAI_API_KEY, ...) must
# never be placed here.

# --- Ports (launcher-managed) -------------------------------------------------
KINDRED_WEB_PORT=8080
KINDRED_API_PORT=3000
BASE_PATH=/
# KINDRED_API_ORIGIN is normally derived from KINDRED_API_PORT
# (http://127.0.0.1:3000). Only override it when the API must run elsewhere;
# do not paste a fixed example here or it will shadow a different
# KINDRED_API_PORT.

# --- Development database -----------------------------------------------------
# disposable: the launcher runs an in-memory MongoDB replica set just for you
#             (data is lost when `pnpm dev` stops). No installation needed.
# external:   point MONGODB_URI/MONGODB_DATABASE below at your own local MongoDB.
KINDRED_DEV_DB=disposable
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=kindred_dev

# --- Frontend (public VITE_* values only) --------------------------------------
# Required public keys for sign-in: a tenant domain, a (public) client id and
# the API audience. Do NOT put secrets here — anything in this file that the
# launcher forwards lands in the browser bundle.
#
# Domain + audience + client id come from your Auth0 tenant and its dev
# Application. Auth0 Dashboard setup (callback/logout/origins) is a manual
# human step — see docs/local-development.md "Auth0 for local development".
#
# A placeholder is shown for the tenant domain; replace YOUR-DEV-TENANT with
# your own tenant (do not reuse identifiers from other environments).
VITE_AUTH0_DOMAIN=YOUR-DEV-TENANT.us.auth0.com
# VITE_AUTH0_CLIENT_ID is optional here: leave it unset to fall back to
# artifacts/kindred-coach/.env.local. If you set it, it must be the public
# client id from your dev Application (never a secret).
# VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://kindred-asterling-ai-coaching.com/api

# --- Backend --------------------------------------------------------------------
# The backend refuses to start unless AI_PROVIDER is set; "disabled" gives a
# runnable dev API without any AI provider. Switch to openai/ollama
# and add the matching keys only when you need AI responses locally.
AI_PROVIDER=disabled
LOG_LEVEL=info
APP_PUBLIC_URL=http://localhost:8080
# AUTH0_DOMAIN/AUTH0_AUDIENCE (backend, JWT validation) MUST match the frontend
# tenant and audience above: the API builds its issuer as
# https://{AUTH0_DOMAIN}/ and validates tokens minted with the same audience.
AUTH0_DOMAIN=YOUR-DEV-TENANT.us.auth0.com
AUTH0_AUDIENCE=https://kindred-asterling-ai-coaching.com/api
# REMINDER_SCHEDULER_DISABLED is set automatically by the launcher and should
# not be edited here. Production never sets it, so scheduling is unchanged.

# --- Optional integrations (leave blank unless you need them locally) --------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# HELCIM_PAYMENTS_ENABLED=false
