# Kindred Asterling AI Coaching — local development configuration
# Values beginning with op:// are unresolved 1Password references, never
# resolved credentials. Update item/field names if your vault uses different
# names, then run:
# op run --env-file=.env.1password -- pnpm --filter @workspace/api-server run dev

# Application runtime
NODE_ENV=development
PORT=8080
APP_PUBLIC_URL=http://localhost:8080
BASE_PATH=/
LOG_LEVEL=debug
TRUST_PROXY_HOPS=1

# MongoDB runtime database. Point MONGODB_URI at the existing development item.
MONGODB_URI=
MONGODB_DATABASE=kindred

# One-time migration job only; do not provide these to the API runtime.
POSTGRES_SOURCE_URL=op://Kindred AI Server/Kindred - Database Development/credential
PG_SSL_CA=
MONGODB_MIGRATION_DATABASE=kindred_migration

# Clerk
CLERK_SECRET_KEY=op://Kindred AI Server/Kindred - Clerk Development/secret key
CLERK_PUBLISHABLE_KEY=op://Kindred AI Server/Kindred - Clerk Development/publishable key
CLERK_WEBHOOK_SECRET=op://Kindred AI Server/Kindred - Clerk Development/webhook secret
VITE_CLERK_PUBLISHABLE_KEY=op://Kindred AI Server/Kindred - Clerk Development/publishable key

# AI — default local provider is Ollama. For hosted inference, use the
# OpenAI-compatible endpoint through Cloudflare AI Gateway after the privacy
# and staging gates. Keep the provider key in the runtime secret store.
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OPENAI_API_KEY=op://Kindred AI Server/Kindred - OpenAI Development/api key
OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/YOUR_GATEWAY_ID/openai
OPENAI_MODEL=gpt-5-mini

# Helcim
HELCIM_PAYMENTS_ENABLED=false
HELCIM_API_KEY=op://Kindred AI Server/Kindred - Helcim Development/api key
HELCIM_WEBHOOK_SECRET=op://Kindred AI Server/Kindred - Helcim Development/webhook secret
HELCIM_CUSTOMER_REFERENCE_SECRET=op://Kindred AI Server/Kindred - Helcim Development/customer reference secret
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_LIFETIME_INVOICE_PREFIX=KINDRED-LIFETIME-
HELCIM_PORTAL_URL=
HELCIM_EMAIL_MIGRATION_FALLBACK=false

# Subscription policy
SUBSCRIPTION_OWNER_IDS=op://Kindred AI Server/Kindred - App Config/subscription owner ids
SUBSCRIPTION_OWNER_EMAILS=op://Kindred AI Server/Kindred - App Config/subscription owner emails
DAILY_CHAT_LIMIT=100

# Messaging and voice
RESEND_API_KEY=op://Kindred AI Server/Kindred - Resend Development/api key
RESEND_FROM_EMAIL=op://Kindred AI Server/Kindred - Resend Development/from email
TWILIO_ACCOUNT_SID=op://Kindred AI Server/Kindred - Twilio Development/account sid
TWILIO_AUTH_TOKEN=op://Kindred AI Server/Kindred - Twilio Development/auth token
TWILIO_PHONE_NUMBER=op://Kindred AI Server/Kindred - Twilio Development/phone number
ELEVENLABS_API_KEY=op://Kindred AI Server/Kindred - ElevenLabs Development/api key

# Google Calendar
GOOGLE_CLIENT_ID=op://Kindred AI Server/Kindred - Google Calendar Development/client id
GOOGLE_CLIENT_SECRET=op://Kindred AI Server/Kindred - Google Calendar Development/client secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/callback
CALENDAR_OAUTH_STATE_SECRET=op://Kindred AI Server/Kindred - Google Calendar Development/state secret
CALENDAR_TOKEN_ENCRYPTION_KEY=op://Kindred AI Server/Kindred - Google Calendar Development/token encryption key
