# Kindred Asterling AI Coaching configuration
# Copy this file to .env and replace placeholders for local development.
# In Fly.io, add applicable runtime names as variables/secrets.
# VITE_* entries are public build arguments; never put a secret in a VITE_* variable.
# POSTGRES_SOURCE_URL is migration-environment-only and must never be added to
# the application runtime.

# Public browser build configuration
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

VITE_SOCIAL_WHATSAPP_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_THREADS_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GOOGLE_BUSINESS_URL=
VITE_SOCIAL_PATREON_URL=

# Application runtime
NODE_ENV=production
PORT=8080
APP_PUBLIC_URL=https://kindred.example.com
BASE_PATH=/
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# MongoDB is the current application database. Keep the default until migration
# and production cutover gates pass. Never expose database credentials through VITE_*.
DATABASE_PROVIDER=mongo
MONGODB_URI=
MONGODB_DATABASE=kindred

# PostgreSQL staging/runtime option after the reviewed full schema is applied.
# Set DATABASE_PROVIDER=postgres and store POSTGRES_URL as a server-only secret.
POSTGRES_URL=

# One-time PostgreSQL migration job only. Never add these to app runtime.
POSTGRES_SOURCE_URL=
POSTGRES_RESTORE_URL=
PG_SSL_CA=
MONGODB_MIGRATION_DATABASE=
MONGODB_MIGRATION_REPORT_PATH=
MONGODB_VALIDATION_SOURCE_DATABASE=
MONGODB_VALIDATION_RESTORE_DATABASE=

# Auth0 runtime: same tenant and audience as the public browser build above.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Legacy Clerk configuration: retain for rollback/offline inventory until the
# Auth0 cutover and rollback window are complete. Not used by the new runtime.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# AI provider: OpenAI-compatible inference routed through Cloudflare AI Gateway
# after the provider review and staging gates. Keep payload logging disabled in
# Gateway settings as well as in the request header.
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OPENAI_API_KEY=
# For Cloudflare's account REST endpoint, OPENAI_API_KEY is a server-only
# Cloudflare token with Account > Workers AI > Read, scoped to your account.
OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
CLOUDFLARE_AI_GATEWAY_ID=kindred-staging
OPENAI_MODEL=openai/gpt-4.1-mini

# Helcim payments. When disabled, the remaining HELCIM_* entries may be blank.
HELCIM_PAYMENTS_ENABLED=false
HELCIM_API_KEY=
HELCIM_WEBHOOK_SECRET=
HELCIM_CUSTOMER_REFERENCE_SECRET=
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_LIFETIME_INVOICE_PREFIX=KINDRED-LIFETIME-
HELCIM_PORTAL_URL=
HELCIM_EMAIL_MIGRATION_FALLBACK=false

# Subscription policy
SUBSCRIPTION_OWNER_IDS=
SUBSCRIPTION_OWNER_EMAILS=
DAILY_CHAT_LIMIT=100

# Email (required in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional SMS reminders; configure all three together.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional voice synthesis
ELEVENLABS_API_KEY=

# Optional Google Calendar integration; configure the complete group or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
